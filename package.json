{
  "name": "dsh-agent-foreman",
  "displayName": "包工头",
  "description": "父智能体派单，承包商子智能体干活：每个承包商可以单独指定 provider / 模型 / 思考等级，产物回流成一块共享看板，父智能体逐个验收、不合格打回返工。",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "docs",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test --test-force-exit \"test/**/*.test.mjs\""
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "subagent",
    "orchestrator",
    "foreman",
    "包工头"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "author": "Dclef",
  "homepage": "https://github.com/Dclef/dsh-agent-foreman#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dclef/dsh-agent-foreman.git"
  },
  "bugs": {
    "url": "https://github.com/Dclef/dsh-agent-foreman/issues"
  }
}
